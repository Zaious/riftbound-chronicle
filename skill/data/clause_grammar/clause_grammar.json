      "alternatives": {
        "backline": {
          "pattern": "\\[backline(?: (?P<backline_grant_value>\\d+))?\\]",
          "value": {
            "keyword": "backline"
          }
        },
        "ganking": {
          "pattern": "\\[ganking(?: (?P<ganking_grant_value>\\d+))?\\]",
          "value": {
