{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zaious/riftbound-chronicle/skill/schemas/cost-receipt.schema.json",
  "title": "Chronicle Cost Receipt v1",
  "description": "ADR-0005 §4: per-component record of what a play cost and whether the rules consider each component paid. Payment events are unique at the receipt level; components reference them with exact allocations. `cost_receipt.py` enforces the relations the shape alone cannot (allocation sums, paid consistency, aggregate equals total).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "play_id", "actor", "card", "base", "after_base_modifications", "components", "aggregate", "discount_order", "order_provenance", "payment_events", "total", "paid", "rule_locators"],
  "properties": {
    "schema_version": {"const": "riftbound-cost-receipt.v1"},
    "play_id": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "card": {"type": "string", "minLength": 1},
    "base": {"$ref": "#/$defs/resource"},
    "after_base_modifications": {"$ref": "#/$defs/resource"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cost_id", "kind", "mandatory", "intent", "requested", "increases", "reductions", "final", "payment_refs", "paid", "rule_locators"],
        "properties": {
          "cost_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "mandatory": {"type": "boolean"},
          "intent": {"type": ["boolean", "null"], "description": "Optional costs: the controller's declared choice (Core 355.1.a). Mandatory and base costs: null."},
          "requested": {},
          "increases": {"type": "array", "items": {"type": "object"}},
          "reductions": {"type": "array", "items": {"type": "object"}},
          "final": {},
          "payment_refs": {"type": "array", "items": {"type": "object", "required": ["event_id"], "properties": {"event_id": {"type": "string", "minLength": 1}, "amount": {"type": "integer", "minimum": 0}}}},
          "paid": {"type": "boolean", "description": "Optional costs: the decision to pay (Core 356.4.f.1). A payment replaced by a replacement effect still counts (Core 357.2.a)."},
          "rule_locators": {"type": "array", "items": {"type": "string"}},
          "domain": {"type": ["string", "null"]},
          "object_id": {"type": ["string", "null"]}
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["energy"],
      "properties": {
        "energy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before_total_discounts", "reductions", "final"],
          "properties": {
            "before_total_discounts": {"type": "integer", "minimum": 0},
            "reductions": {"type": "array", "items": {"type": "object"}},
            "final": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "discount_order": {"type": "array", "items": {"type": "object", "required": ["id", "tier"], "properties": {"id": {"type": "string"}, "tier": {"enum": ["component", "total"]}}}},
    "order_provenance": {"type": "string", "minLength": 1},
    "payment_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "kind"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["pay_energy", "pay_power", "pay_exhaust", "pay_kill"]},
          "amount": {"type": "integer", "minimum": 1},
          "domain": {"type": "string", "minLength": 1},
          "before": {"type": "integer", "minimum": 0},
          "after": {"type": "integer", "minimum": 0},
          "cost_id": {"type": "string"},
          "object_id": {"type": "string"},
          "outcome": {"type": "string"},
          "rule_locators": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "total": {"$ref": "#/$defs/resource"},
    "paid": {"type": "boolean"},
    "rule_locators": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["energy", "power"],
      "properties": {
        "energy": {"type": "integer", "minimum": 0},
        "power": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "power_any": {"type": "integer", "minimum": 0, "description": "Any-domain Power due (Core 809.1.c.1), paid by a resource_allocation."}
      }
    }
  }
}
