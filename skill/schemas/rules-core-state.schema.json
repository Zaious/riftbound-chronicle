{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zaious/riftbound-chronicle/skill/schemas/rules-core-state.schema.json",
  "title": "Chronicle Sovereign Rules Core State v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ruleset", "players", "turn_order", "turn_player", "phase", "showdown", "priority", "outstanding_tasks", "chain"],
  "properties": {
    "schema_version": {"const": "riftbound-rules-core-state.v1"},
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "faq_as_of"],
      "properties": {
        "core": {"type": "string", "format": "date"},
        "faq_as_of": {"type": "string", "format": "date"}
      }
    },
    "players": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "turn_order": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "turn_player": {"type": "string", "minLength": 1},
    "phase": {"type": "string", "minLength": 1},
    "showdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "kind", "focus"],
      "properties": {
        "active": {"type": "boolean"},
        "kind": {"type": ["string", "null"], "enum": ["combat", "non_combat", null]},
        "focus": {"type": ["string", "null"]},
        "battlefield": {"type": ["string", "null"], "description": "ADR-0008 §2: the Battlefield the Showdown is at; required to match a staged Combat to it (323.14, 464.1)."},
        "focus_passes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "Players who passed Focus in sequence since the last play (347.2.a); every player passing closes the Showdown (348)."},
        "closing": {"type": "boolean", "description": "ADR-0009 §4: every player passed Focus in a Non-Combat Showdown; control resolution is the next required procedure (348.2)."}
      }
    },
    "staged_showdowns": {
      "type": "array",
      "description": "ADR-0009 §3: the Non-Combat Showdowns staged by the last Cleanup (316.8.b, 323.8); the Turn Player chooses which opens (323.12).",
      "items": {"type": "object", "additionalProperties": false, "required": ["battlefield", "battlefield_identity", "contested_by"], "properties": {"battlefield": {"type": "string", "minLength": 1}, "battlefield_identity": {"type": "string", "pattern": "^.+@[0-9]+$"}, "contested_by": {"type": "string", "minLength": 1}}}
    },
    "combat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["combat_id", "battlefield", "battlefield_identity", "status", "attacker", "defender", "participants", "triggered_identities"],
      "description": "ADR-0008 §1: the one Combat staged or in progress. Absent means none — never an unknown Combat fact.",
      "properties": {
        "combat_id": {"type": "string", "minLength": 1},
        "battlefield": {"type": "string", "minLength": 1},
        "battlefield_identity": {"type": "string", "pattern": "^.+@[0-9]+$"},
        "status": {"enum": ["staged", "open", "showdown_closed", "damage_assigned", "damage_dealt", "cleanup_done", "result_determined", "control_resolved", "closed"]},
        "attacker": {"type": ["string", "null"]},
        "defender": {"type": ["string", "null"]},
        "participants": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "triggered_identities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attacker", "defender"],
          "properties": {
            "attacker": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^.+@[0-9]+$"}},
            "defender": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^.+@[0-9]+$"}}
          }
        },
        "opened_with": {"enum": ["new_showdown", "existing_showdown"]},
        "battlefield_triggered": {"type": "array", "uniqueItems": true, "items": {"enum": ["attacker", "defender"]}, "description": "ADR-0008 §4: which of the Battlefield's own Attack/Defend triggers fired this Combat."},
        "assignments": {"type": ["object", "null"], "description": "ADR-0008 §8–9: the attacker's and defender's Combat Damage assignment receipts (riftbound-combat-assignment-receipt.v1) once assigned; null when the damage step was skipped (465.1)."},
        "damage_step_skipped": {"type": "boolean"},
        "assignment_snapshot": {"type": "object", "additionalProperties": false, "required": ["effect_state_hash", "receipts_hash"], "properties": {"effect_state_hash": {"type": "string"}, "receipts_hash": {"type": "string"}}, "description": "The effect state and receipts the Deal step must see unchanged (465.2.c.1.a)."},
        "restaged_from": {"type": "string", "minLength": 1, "description": "466.3.d.1: the closed Combat this staged Combat follows."},
        "damage_dealt": {"type": "object", "description": "ADR-0008 §10: the applied amounts Dealt per side from the receipts (465.2.d)."},
        "cleanup": {"type": "object", "description": "ADR-0008 §10: what the Combat Cleanup did (killed with attribution, healed, recalled; 466.1, 428.5.c.2)."},
        "result": {"type": "object", "description": "ADR-0008 §10: the Combat result per 466.3 (win / no_result, winner, loser, reason, units_remaining, restage_required)."},
        "control": {"type": "object", "description": "ADR-0009 §2: what resolve_battlefield_control did (step, controller_after, scoring)."},
        "sync_count": {"type": "integer", "minimum": 0}
      }
    },
    "priority": {"type": ["string", "null"]},
    "outstanding_tasks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "ending_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "turn_id"],
      "description": "ADR-0007 §8: the Ending Step's progress for this turn (Core 317). Absent before begin_ending_step.",
      "properties": {
        "status": {"enum": ["triggers_scheduled", "expired"]},
        "turn_id": {"type": "string", "minLength": 1},
        "scheduled_triggers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initiated_by", "items", "consecutive_passes"],
      "properties": {
        "initiated_by": {"type": ["string", "null"], "enum": ["played_card", "activated_ability", "triggered_ability", "add_ability", null]},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "controller", "object_kind", "timing", "status", "ability_kind"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "controller": {"type": "string", "minLength": 1},
              "object_kind": {"enum": ["spell", "unit", "gear", "ability"]},
              "timing": {"enum": ["default", "action", "reaction", "triggered"]},
              "status": {"enum": ["pending", "finalized"]},
              "ability_kind": {"type": ["string", "null"], "enum": ["standard", "add", null]},
              "source_object": {"type": "string", "minLength": 1},
              "effect_program_id": {"type": ["string", "null"]},
              "optional_at_finalize": {"type": "boolean"},
              "trigger_kind": {"enum": ["triggered", "self_death", "reflexive"]},
              "batch_sequence": {"type": "integer", "minimum": 0},
              "batch_id": {"type": "string", "minLength": 1}
            }
          }
        },
        "consecutive_passes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
