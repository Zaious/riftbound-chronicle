      "clauses": [
        {
          "clause_id": "morbid return#f3c76e58",
          "text": "Return a unit from your trash to your hand.",
          "required_mechanics": [
            "return_trash_to_hand",
            "target_choice"
          ],
          "implemented_ops": [],
          "targets": true,
