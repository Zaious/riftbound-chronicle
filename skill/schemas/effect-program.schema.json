{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zaious/riftbound-chronicle/skill/schemas/effect-program.schema.json",
  "title": "Chronicle Typed Effect Program v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ruleset", "program_id", "effects"],
  "properties": {
    "schema_version": {"const": "riftbound-effect-program.v1"},
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "faq_as_of"],
      "properties": {
        "core": {"const": "2026-07-16"},
        "faq_as_of": {"const": "2026-08-14"}
      }
    },
    "program_id": {"type": "string", "minLength": 1},
    "controller": {"type": "string", "minLength": 1},
    "source_object": {"type": "string", "minLength": 1},
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op"],
        "properties": {
          "op": {"enum": ["draw", "recycle_one", "move_board_object", "modify_might", "deal_damage", "heal_damage", "ready", "exhaust", "add_resource", "play_token", "kill", "emit_reflexive"]},
          "effect_id": {"type": "string", "minLength": 1},
          "depends_on": {"type": "string", "minLength": 1},
          "dependency_mode": {"enum": ["if_applied", "always"]},
          "replacement_order": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "replacement_decider": {"type": "string", "minLength": 1},
          "replacement_choices": {"type": "object", "additionalProperties": {"type": "boolean"}},
          "owner": {"type": "string", "minLength": 1},
          "controller": {"type": "string", "minLength": 1},
          "token_kind": {"enum": ["unit", "gear"]},
          "base_might": {"type": "integer", "minimum": 0},
          "destination": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {"enum": ["base", "battlefield"]},
              "player": {"type": "string", "minLength": 1},
              "battlefield": {"type": "string", "minLength": 1}
            }
          },
          "event_modifiers": {"$ref": "#/$defs/eventModifiers"},
          "modifier_inheritance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule"],
            "properties": {
              "rule": {"const": "Core 375"},
              "from_effect_id": {"type": ["string", "null"]}
            }
          },
          "target": {"$ref": "#/$defs/selector"},
          "targets": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max"],
            "properties": {
              "min": {"type": "integer", "minimum": 0},
              "max": {"type": "integer", "minimum": 1},
              "selectors": {"type": "array", "items": {"$ref": "#/$defs/selector"}},
              "decision_ref": {"type": "string", "minLength": 1},
              "restrictions": {"type": "object", "additionalProperties": false, "properties": {
                "chosen_zone_class": {"enum": ["board", "non_board"]},
                "kind": {"enum": ["unit", "gear", "spell", "rune"]},
                "location": {"enum": ["board", "battlefield", "base", "non_board", "main_deck", "hand", "trash", "banishment", "rune_deck"]},
                "controller_relation": {"enum": ["friendly", "enemy"]},
                "zone_owner_relation": {"enum": ["own", "opponent"]},
                "max_might": {"type": "integer", "minimum": 0}
              }}
            }
          },
          "triggers": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/triggerDescriptor"}
          }
        }
      }
    }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chosen_zone_class"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "decision_ref": {"type": "string", "minLength": 1},
        "bound_object_id": {"type": "string", "minLength": 1},
        "bound_identity": {"type": "string", "pattern": "^.+@[0-9]+$"},
        "chosen_zone_class": {"enum": ["board", "non_board"]},
        "kind": {"enum": ["unit", "gear", "spell", "rune"]},
        "location": {"enum": ["board", "battlefield", "base", "non_board", "main_deck", "hand", "trash", "banishment", "rune_deck"]},
        "controller_relation": {"enum": ["friendly", "enemy"]},
        "zone_owner_relation": {"enum": ["own", "opponent"]},
        "targeted": {"type": "boolean", "description": "Derived from the selector (Core 355.7–355.10); a supplied value that disagrees with the derivation is invalid."},
        "max_might": {"type": "integer", "minimum": 0}
      }
    },
    "eventModifiers": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "entry_state": {"enum": ["ready", "exhausted"]},
        "result_keywords": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["temporary"]}
        }
      }
    },
    "triggerDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger_id", "controller", "source_object", "controller_order", "effect_program_id", "optional_at_finalize"],
      "properties": {
        "trigger_id": {"type": "string", "minLength": 1},
        "controller": {"type": "string", "minLength": 1},
        "source_object": {"type": "string", "minLength": 1},
        "controller_order": {"type": "integer", "minimum": 0},
        "effect_program_id": {"type": "string", "minLength": 1},
        "optional_at_finalize": {"type": "boolean"}
      }
    }
  }
}
