{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zaious/riftbound-chronicle/skill/schemas/cleanup-decisions.schema.json",
  "title": "Chronicle Cleanup Decisions v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"const": "riftbound-cleanup-decisions.v1"},
    "replacement_event_order": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "replacement_choices": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"type": "boolean"}
      }
    }
  }
}
