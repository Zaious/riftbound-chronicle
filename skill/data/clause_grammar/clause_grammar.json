          "value": {
            "keyword": "hunt",
            "implemented": false
          }
        },
        "level": {
          "pattern": "\\[level(?: (?P<level_value>\\d+))?\\]",
          "value": {
            "keyword": "level",
            "implemented": false
          }
        },
        "repeat": {
          "pattern": "\\[repeat(?: (?P<repeat_value>\\d+))?\\]",
          "value": {
            "keyword": "repeat",
            "implemented": true
          }
        },
        "shield": {
          "pattern": "\\[shield(?: (?P<shield_value>\\d+))?\\]",
          "value": {
            "keyword": "shield",
            "implemented": true
          }
        },
        "tank": {
          "pattern": "\\[tank(?: (?P<tank_value>\\d+))?\\]",
          "value": {
            "keyword": "tank",
            "implemented": true
          }
        },
        "temporary": {
          "pattern": "\\[temporary(?: (?P<temporary_value>\\d+))?\\]",
          "value": {
            "keyword": "temporary",
            "implemented": false
          }
        },
        "unique": {
          "pattern": "\\[unique(?: (?P<unique_value>\\d+))?\\]",
          "value": {
            "keyword": "unique",
            "implemented": false
          }
        },
        "vision": {
          "pattern": "\\[vision(?: (?P<vision_value>\\d+))?\\]",
          "value": {
            "keyword": "vision",
            "implemented": false
          }
        }
      }
    },
