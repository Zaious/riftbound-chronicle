    {
      "card": "Meditation",
      "type": "Spell",
      "printing": "ogn-048-298",
      "stale": false,
      "clauses": [
        {
          "clause_id": "meditation#6ce549b5",
          "text": "As an additional cost to play this, you may exhaust a friendly unit.",
          "required_mechanics": [
            "optional_additional_cost"
          ],
          "implemented_ops": [
            "exhaust"
          ],
          "targets": false,
          "decision_point": "at_play",
          "rationale": "355.1.a the choice to pay an optional additional cost is made at play; 355.10.c a cost does not target; 356.2.b/357.2 paid in step 4; 414.4 an exhausted unit cannot pay it",
          "locators": [
            {
              "locator": "Core 355.1.a",
              "excerpt": "This includes the choice of whether or not to pay an Optional Additional Cost.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 355.10.c",
              "excerpt": "'As an additional cost to play me, kill a friendly unit' doesn't target anything.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 204.2.a",
              "excerpt": "Additional Costs must be paid to finalize the spell or ability, in addition to the base cost.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 356.2.b.1",
              "excerpt": "Optional Costs … must be paid only if the player made the choice to pay them in step 2. They use the phrase 'as an additional cost' and the word 'may.'",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 356.4.f.1",
              "excerpt": "An optional additional cost was 'paid' if the player made the decision to pay it. It doesn't matter how much the player actually paid.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 357.2",
              "excerpt": "In addition, pay any non-standard Cost summed in step 3 in any order.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 357.2.a",
              "excerpt": "Costs that are replaced with other events by replacement effects are still considered paid.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 414.4",
              "excerpt": "An exhausted friendly unit may not be exhausted again as the additional cost for the spell, and the additional cost has not been paid.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 358.2",
              "excerpt": "Check that all costs were paid.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 358.5",
              "excerpt": "If any of the above checks fail, the actions taken in this process are undone and the action is cancelled.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 205",
              "excerpt": "An instruction that requires a player to pay resources … that does not also have a linked Effect, is not a Cost.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            }
          ],
          "packets": [
            "DP-02",
            "DP-04",
            "DP-05"
          ]
        }
      ]
    },
    {
      "card": "Mobilize",
      "type": "Spell",
      "printing": "ogn-134-298",
      "stale": false,
      "clauses": [
        {
          "clause_id": "mobilize#3e791d2d",
          "text": "Channel 1 rune exhausted.",
          "required_mechanics": [
            "channel_rune"
          ],
          "implemented_ops": [],
          "targets": false,
          "decision_point": "none",
          "rationale": "430.1 channel takes the top rune (no choice); 430.2 the effect specifies entry state; 430.3 channel as many as possible",
          "locators": [
            {
              "locator": "Core 430.1",
              "excerpt": "Channeling is the action of taking one or more Runes from the top of a player's Rune Deck and putting them on the board.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 430.2",
              "excerpt": "A spell reads 'Channel 1 rune exhausted.' As that spell resolves, its controller puts the top rune of their rune deck onto the board and that rune enters the board exhausted rather than ready.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 430.3",
              "excerpt": "If there aren't sufficient runes in the Rune Deck, channel as many as possible.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 430.5",
              "excerpt": "e.g., 'Channel 2 runes exhausted. If you couldn't channel 2 runes this way, draw 1.'",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 161.1.a",
              "excerpt": "despite remaining on the Board until Recycled or otherwise removed from the board, it is not a Permanent.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            }
          ],
          "packets": [
            "DP-05",
            "DP-08"
          ]
        }
      ]
    },
