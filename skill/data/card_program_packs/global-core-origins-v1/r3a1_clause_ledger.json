    {
      "card": "Disintegrate",
      "type": "Spell",
      "printing": "ogn-005-298",
      "stale": true,
      "clauses": [
        {
          "clause_id": "disintegrate#d3d94631",
          "text": "Deal 3 to a unit at battlefield.",
          "required_mechanics": [
            "target_choice"
          ],
          "implemented_ops": [
            "deal_damage"
          ],
          "targets": true,
          "decision_point": "at_play",
          "rationale": "355.5 specific object choice at play; 355.10.b 'at battlefield' is a restriction, the unit is the target",
          "locators": [
            {
              "locator": "Core 355.5",
              "excerpt": "If a card requires you to specifically choose one or more Game Objects, that choice is made now.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 355.8",
              "excerpt": "In order to put a spell or ability on the chain, valid choices must be made for all targets.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 355.9.b",
              "excerpt": "It meets all targeting restrictions. e.g., a unit is a valid target for a spell that refers to a 'unit at a battlefield' only if it meets the appropriate criteria.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 355.10.b",
              "excerpt": "'Kill a unit at a battlefield' targets a unit, but not a battlefield, because the units are targets and 'at a battlefield' is a restriction.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 359.3.e.5",
              "excerpt": "If any of the spell's targets are no longer legal, those game objects are unaffected by the spell as it resolves.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 417.1.b",
              "excerpt": "To Deal Damage to Units, mark the specified amount of Damage on the Unit.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 417.6.a",
              "excerpt": "If a game effect does not specify a source, the game effect describing the Deal action is the source.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "errata: Disintegrate OGN-005",
              "excerpt": "Deal 3 to a unit at battlefield. If this kills it, do this: draw 1.",
              "source_id": "origins-errata-2025-10-28",
              "version": "2025-10-28",
              "kind": "errata"
            }
          ],
          "packets": [
            "DP-01",
            "DP-03"
          ]
        }
      ]
    },
    {
      "card": "Flash",
      "type": "Spell",
      "printing": "ogs-011-024",
      "stale": false,
      "clauses": [
        {
          "clause_id": "flash#7a92a690",
          "text": "Move up to 2 friendly units to base.",
          "required_mechanics": [
            "target_choice"
          ],
          "implemented_ops": [
            "move_board_object"
          ],
          "targets": true,
          "decision_point": "at_play",
          "rationale": "355.4 move destinations chosen at play; 355.13 'up to' may choose zero; 355.12 each chosen unit is a target",
          "locators": [
            {
              "locator": "Core 355.4",
              "excerpt": "For Spells and Abilities that Move one or more Units, choose a valid Location as the Move Destination for each Move that will be performed.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 355.4.a",
              "excerpt": "A valid Location for a Move Effect is one other than the Units' current Location where they are allowed to be present.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 355.13",
              "excerpt": "If a card specifies that a player chooses 'any number' or 'up to' some number of Game Objects to be affected, they may choose any number of available targets, including zero.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 446.3.c",
              "excerpt": "Moving does not use the Chain, nor is it able to be Reacted to.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 449.1",
              "excerpt": "The source of the Move will provide details on any restrictions on legality for Destination.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 453",
              "excerpt": "When a Move action is complete, perform a Cleanup.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            }
          ],
          "packets": [
            "DP-01",
            "DP-02",
            "DP-06"
          ]
        }
      ]
    },
    {
      "card": "Gentlemen's Duel",
      "type": "Spell",
      "printing": "ogs-008-024",
      "stale": false,
      "clauses": [
        {
          "clause_id": "gentlemen's duel#2ed49f33",
          "text": "Give a friendly unit +3 :rb_might: this turn.",
          "required_mechanics": [
            "target_choice",
            "duration_expiry"
          ],
          "implemented_ops": [
            "modify_might"
          ],
          "targets": true,
          "decision_point": "at_play",
          "rationale": "friendly-unit choice at play; duration 'this turn' is R3-A2 but the target is A1",
          "locators": [
            {
              "locator": "Core 355.5",
              "excerpt": "If a card requires you to specifically choose one or more Game Objects, that choice is made now.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 355.9.b",
              "excerpt": "A unit is a valid target for a spell that refers to a 'unit you control' only if it meets the appropriate criteria.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 359.3.e.2",
              "excerpt": "A target is illegal as the spell resolves if it no longer meets the targeting requirements of the spell.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 135.2.e.3",
              "excerpt": "(Might modifier accounting, as effect_ir already cites for modify_might)",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            }
          ],
          "packets": [
            "DP-01",
            "DP-03"
          ]
        },
        {
          "clause_id": "gentlemen's duel#fd48e5d0",
          "text": "Then choose an enemy unit.",
          "required_mechanics": [
            "target_choice"
          ],
          "implemented_ops": [],
          "targets": true,
          "decision_point": "at_play",
          "rationale": "a second, independent target chosen at play (355.5); 'Then' orders execution, not the choice",
          "locators": [
            {
              "locator": "Core 355.5",
              "excerpt": "If a card requires you to specifically choose one or more Game Objects, that choice is made now.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 355.16",
              "excerpt": "A player may not make choices during this step that will deterministically result in illegal choices or actions later in this process unless they have no choice.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 359.3.e.7",
              "excerpt": "If all of an instruction's Targets become Invalid or Unavailable by the time the spell begins resolving, that instruction will not execute.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            }
          ],
          "packets": [
            "DP-01",
            "DP-03"
          ]
        }
      ]
    },
    {
      "card": "Gust",
      "type": "Spell",
      "printing": "ogn-169-298",
      "stale": false,
      "clauses": [
        {
          "clause_id": "gust#e661650e",
          "text": "Return a unit at a battlefield with 3 :rb_might: or less to its owner's hand.",
          "required_mechanics": [
            "return_board_to_hand",
            "target_choice"
          ],
          "implemented_ops": [],
          "targets": true,
          "decision_point": "at_play",
          "rationale": "targeted choice with two restrictions; returning to hand is a zone change, not a Move (446.2), and the object becomes new (124)",
          "locators": [
            {
              "locator": "Core 355.9.b",
              "excerpt": "A unit is a valid target for a spell that refers to a 'unit with Might 4 or greater' only if it meets the appropriate criteria.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 359.3.e.4",
              "excerpt": "A unit with 3 or less Might is no longer a legal target if it is no longer a unit or if its Might is greater than 3.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 446.2",
              "excerpt": "A card changing game zones does not in itself constitute a Move.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 124",
              "excerpt": "A Game Object that changes zones to or from a Non-Board Zone becomes a new object for the purposes of tracking that object.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 124.1",
              "excerpt": "Whenever a Game Object changes zones to or from a Non-Board Zone, all Temporary Modifications of all kinds cease to be tracked on it.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 056",
              "excerpt": "Cards a player owns may never be placed into a non-Board zone belonging to another player.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            }
          ],
          "packets": [
            "DP-01",
            "DP-03",
            "DP-06"
          ]
        }
      ]
    },
    {
      "card": "Highlander",
      "type": "Spell",
      "printing": "ogs-020-024",
      "stale": true,
      "clauses": [
        {
          "clause_id": "highlander#d659b2ba",
          "text": "Choose a friendly unit.",
          "required_mechanics": [
            "target_choice"
          ],
          "implemented_ops": [],
          "targets": true,
          "decision_point": "at_play",
          "rationale": "355.10.c's own example: 'Choose a friendly unit. The next time it would die this turn…' targets a friendly unit, because 'choose' is not part of the replacement effect",
          "locators": [
            {
              "locator": "Core 355.10.c",
              "excerpt": "'Choose a friendly unit. The next time it would die this turn, return it to your hand instead' targets a friendly unit, because 'choose a friendly unit' is not part of the replacement effect.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 355.5",
              "excerpt": "If a card requires you to specifically choose one or more Game Objects, that choice is made now.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 359.3.e.5",
              "excerpt": "Any instructions related to an illegal target can't be followed.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
