              "locator": "Core 355.9.a",
              "excerpt": "e.g., 'Recycle a unit from your trash' targets a unit card in your trash.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 355.10.a",
              "excerpt": "'Return a unit from your trash to your hand' targets a unit card in your trash, because your trash is Public.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 355.10.a.1",
              "excerpt": "Public zones are Battlefield Zones, Bases, Trashes, Legend Zones, Champion Zones, and Facedown Zones.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 359.3.e.2",
              "excerpt": "A target is illegal as the spell resolves if it has changed Zones to or from a Non-Board Zone.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 108.2.c",
              "excerpt": "Cards in each player's Trash are unordered.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            }
          ],
          "packets": [
            "DP-01",
            "DP-03",
            "DP-06"
          ]
        }
      ]
    },
    {
      "card": "Mystic Poro",
      "type": "Unit",
      "printing": "ogn-171-298",
      "stale": false,
      "clauses": [
        {
          "clause_id": "mystic poro#f4a07c4d",
          "text": "[Vision]",
          "required_mechanics": [
            "look",
            "play_and_move_triggers"
          ],
          "implemented_ops": [
            "recycle_one"
          ],
          "targets": false,
          "decision_point": "at_resolution",
          "rationale": "817.1.b Vision is a triggered ability short for 'When this is played, predict'; 436 the recycle choice is made as Predict executes; the top card is Secret (128.3) and does not target (355.10.a)",
          "locators": [
            {
              "locator": "Core 817.1.b",
              "excerpt": "It is functionally short for 'When this is played, predict.'",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 817.1.c",
              "excerpt": "The trigger is the permanent entering the Board.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 817.2.a",
              "excerpt": "The player may choose to recycle or not recycle for each instance of Vision separately.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 436.1",
              "excerpt": "Predicting a card is the act of looking at a single card from the top of the Main Deck and choosing whether or not to Recycle it.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 436.4",
              "excerpt": "If a player attempts to Predict more cards than are available in their Main Deck, they will Predict as many as possible instead.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 128.3",
              "excerpt": "Secret: This level of Privacy indicates that no player may read or look at the face of the card.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            },
            {
              "locator": "Core 355.5.b",
              "excerpt": "This does not include making choices for Triggered Abilities of permanents, even if those abilities trigger when the chain item is played.",
              "source_id": "core-rules-2026-07-16",
              "version": "2026-07-16",
              "kind": "core_rules"
            }
          ],
          "packets": [
            "DP-02",
            "DP-07"
          ]
        }
      ]
    },
