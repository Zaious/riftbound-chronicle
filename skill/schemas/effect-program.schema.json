{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zaious/riftbound-chronicle/skill/schemas/effect-program.schema.json",
  "title": "Chronicle Typed Effect Program v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ruleset", "program_id", "effects"],
  "properties": {
    "schema_version": {"const": "riftbound-effect-program.v1"},
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "faq_as_of"],
      "properties": {
        "core": {"const": "2026-07-16"},
        "faq_as_of": {"const": "2026-08-14"}
      }
    },
    "program_id": {"type": "string", "minLength": 1},
    "cost_receipt": {"$ref": "cost-receipt.schema.json"},
    "conditional_triggers": {
      "type": "array",
      "description": "Reflexive triggers whose condition is only known after Cleanup (Core 428.5.c, 387–388). The resolution bridge evaluates them and builds Pending items for those that hold; a prevented death builds nothing.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trigger_id", "controller", "source_object", "controller_order", "effect_program_id", "optional_at_finalize", "condition"],
        "properties": {
          "trigger_id": {"type": "string", "minLength": 1},
          "controller": {"type": "string", "minLength": 1},
          "source_object": {"type": "string", "minLength": 1},
          "controller_order": {"type": "integer", "minimum": 0},
          "effect_program_id": {"type": "string", "minLength": 1},
          "optional_at_finalize": {"type": "boolean"},
          "condition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "effect_id"],
            "properties": {"kind": {"enum": ["caused_kill"]}, "effect_id": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "controller": {"type": "string", "minLength": 1},
    "source_object": {"type": "string", "minLength": 1},
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op"],
        "properties": {
          "op": {"enum": ["draw", "recycle_one", "move_board_object", "modify_might", "deal_damage", "heal_damage", "ready", "exhaust", "add_resource", "play_token", "kill", "emit_reflexive", "return_to_hand", "recall", "channel_rune", "grant_turn_effect", "discard"]},
          "effect_id": {"type": "string", "minLength": 1},
          "predicate": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {"enum": ["cost_paid", "cost_not_paid", "action_performed", "action_not_performed", "requested_count_not_reached", "caused_kill", "sole_controlled_unit_at_referent_location"]},
              "cost_id": {"type": "string", "minLength": 1},
              "effect_id": {"type": "string", "minLength": 1}
            }
          },
          "depends_on": {"type": "string", "minLength": 1},
          "dependency_mode": {"enum": ["if_applied", "always"]},
          "replacement_order": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "replacement_decider": {"type": "string", "minLength": 1},
          "replacement_choices": {"type": "object", "additionalProperties": {"type": "boolean"}},
          "owner": {"type": "string", "minLength": 1},
          "controller": {"type": "string", "minLength": 1},
          "token_kind": {"enum": ["unit", "gear"]},
          "entry_state": {"enum": ["ready", "exhausted"], "description": "channel_rune: the state the runes enter with (Core 430.2); ready by default (430.2.a)."},
          "turn_effect_kind": {"enum": ["entry_state_for_played_units"], "description": "grant_turn_effect: a 'this turn' effect expiring at the Expiration Step (317.2)."},
          "decision_ref": {"type": "string", "minLength": 1, "description": "discard: the card_selection decision the discarding player supplies (Core 422.1.a); not needed when the whole hand must go."},
          "value": {},
          "base_might": {"type": "integer", "minimum": 0},
          "destination": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {"enum": ["base", "battlefield"]},
              "player": {"type": "string", "minLength": 1},
              "player_relation": {"enum": ["object_controller"], "description": "Base destination resolved per moved object to its own controller's Base (Core 355.4.a); use instead of a literal player so the program stays portable."},
              "battlefield": {"type": "string", "minLength": 1}
            }
          },
          "event_modifiers": {"$ref": "#/$defs/eventModifiers"},
          "modifier_inheritance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule"],
            "properties": {
              "rule": {"const": "Core 375"},
              "from_effect_id": {"type": ["string", "null"]}
            }
          },
          "target": {"$ref": "#/$defs/selector"},
          "affected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criteria"],
            "description": "Objects found by criteria at resolution (Core 355.5.a, 355.10.d). They are not targets: no revalidation, no Deflect, no untargetability. Over target_battlefield the instruction also carries a battlefield target (355.10.b); over any_battlefield it targets nothing.",
            "properties": {
              "criteria": {
                "type": "object",
                "additionalProperties": false,
                "required": ["location"],
                "properties": {
                  "location": {"enum": ["target_battlefield", "any_battlefield"]},
                  "kind": {"enum": ["unit", "gear"]},
                  "controller_relation": {"enum": ["friendly", "enemy"]}
                }
              }
            }
          },
          "targets": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max"],
            "properties": {
              "min": {"type": "integer", "minimum": 0},
              "max": {"type": "integer", "minimum": 1},
              "selectors": {"type": "array", "items": {"$ref": "#/$defs/selector"}},
              "decision_ref": {"type": "string", "minLength": 1},
              "restrictions": {"type": "object", "additionalProperties": false, "properties": {
                "chosen_zone_class": {"enum": ["board", "non_board"]},
                "kind": {"enum": ["unit", "gear", "spell", "rune"]},
                "location": {"enum": ["board", "battlefield", "base", "non_board", "main_deck", "hand", "trash", "banishment", "rune_deck"]},
                "controller_relation": {"enum": ["friendly", "enemy"]},
                "zone_owner_relation": {"enum": ["own", "opponent"]},
                "max_might": {"type": "integer", "minimum": 0}
              }}
            }
          },
          "triggers": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/triggerDescriptor"}
          }
        }
      }
    }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chosen_zone_class"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "decision_ref": {"type": "string", "minLength": 1},
        "bound_object_id": {"type": "string", "minLength": 1},
        "bound_identity": {"type": "string", "pattern": "^.+@[0-9]+$"},
        "chosen_zone_class": {"enum": ["board", "non_board"]},
        "kind": {"enum": ["unit", "gear", "spell", "rune", "battlefield"]},
        "location": {"enum": ["board", "battlefield", "base", "non_board", "main_deck", "hand", "trash", "banishment", "rune_deck"]},
        "controller_relation": {"enum": ["friendly", "enemy"]},
        "zone_owner_relation": {"enum": ["own", "opponent"]},
        "targeted": {"type": "boolean", "description": "Derived from the selector (Core 355.7–355.10); a supplied value that disagrees with the derivation is invalid."},
        "max_might": {"type": "integer", "minimum": 0}
      }
    },
    "eventModifiers": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "entry_state": {"enum": ["ready", "exhausted"]},
        "result_keywords": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["temporary"]}
        }
      }
    },
    "triggerDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger_id", "controller", "source_object", "controller_order", "effect_program_id", "optional_at_finalize"],
      "properties": {
        "trigger_id": {"type": "string", "minLength": 1},
        "controller": {"type": "string", "minLength": 1},
        "source_object": {"type": "string", "minLength": 1},
        "controller_order": {"type": "integer", "minimum": 0},
        "effect_program_id": {"type": "string", "minLength": 1},
        "optional_at_finalize": {"type": "boolean"}
      }
    }
  }
}
